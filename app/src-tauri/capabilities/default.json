{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "websocket:default",
    "notification:default",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus"
  ]
}
